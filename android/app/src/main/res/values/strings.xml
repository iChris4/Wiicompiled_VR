    <string name="about_credit_title_online">Online</string>
    <string name="about_credit_online">Rooms, Leaderboard and Friends show Retro WFC\'s (rwfc.net) rooms, leaderboard and player profiles, and Friends reads and changes the friend list in Retro Rewind\'s save, as Wheel Wizard does. The status beside the version is the Wheel Wizard team\'s, from Wheel Wizard\'s data.</string>
    <string name="about_credit_title_toolchain">On-headset builds</string>
