<?xml version="1.0" encoding="utf-8"?>
<!-- WheelWizard's MiiBlock, its border: selected in the primary colour, a favourite in gold. The
     tile's foreground, so it frames the Mii whose shoulders reach the tile's bottom edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/primary_400" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/warning_500" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/neutral_500" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/neutral_500" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/neutral_600" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
