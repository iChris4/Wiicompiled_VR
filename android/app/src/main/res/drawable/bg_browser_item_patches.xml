<?xml version="1.0" encoding="utf-8"?>
<!-- A mod that uses patches in the browser's list: ModBrowserListItem's green look. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/patches_item_hover" />
            <stroke android:width="1dp" android:color="@color/primary_300" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/patches_image" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/patches_item_hover" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/patches_item" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
