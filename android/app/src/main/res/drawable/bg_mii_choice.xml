<?xml version="1.0" encoding="utf-8"?>
<!-- A choice in the Mii editor (WheelWizard's MultiIconRadioButton): the chosen one outlined. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_800" />
            <stroke android:width="2dp" android:color="@color/primary_400" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_700" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_700" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_950" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
