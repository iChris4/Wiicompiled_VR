<?xml version="1.0" encoding="utf-8"?>
<!-- WheelWizard's Leaderboard page (Views/Pages/LeaderboardPage.axaml): Retro WFC's top 50, the
     first three on a podium (header_leaderboard.xml) and the rest in a list, or what stops them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <TextView
            style="@style/Launcher.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:text="@string/launcher_nav_leaderboard" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_700" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/leaderboard_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:indeterminateTint="@color/neutral_700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/leaderboard_loading"
                android:textColor="@color/neutral_400"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaderboard_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_triangle"
                android:tint="@color/danger_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/leaderboard_error_title"
                android:textColor="@color/neutral_100"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/leaderboard_error_text"
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/neutral_400"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/leaderboard_retry"
                style="@style/Launcher.Button.Primary"
                android:layout_marginTop="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="24dp"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="10dp"
                android:drawableTint="@color/play_button_content"
                android:text="@string/leaderboard_retry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaderboard_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_award"
                android:tint="@color/neutral_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/leaderboard_empty_title"
                android:textColor="@color/neutral_200"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="440dp"
                android:text="@string/leaderboard_empty_message"
                android:textColor="@color/neutral_400"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/leaderboard_refresh"
                style="@style/Launcher.Button.Primary"
                android:layout_marginTop="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="24dp"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="10dp"
                android:drawableTint="@color/play_button_content"
                android:text="@string/leaderboard_refresh" />
        </LinearLayout>

        <ListView
            android:id="@+id/leaderboard_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@android:color/transparent"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
