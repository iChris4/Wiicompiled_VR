<?xml version="1.0" encoding="utf-8"?>
<!-- WheelWizard's RoomDetailsPage (Views/Pages/RoomDetailsPage.axaml): a room's ID, time online,
     game mode and average VR, and its players; a player opens their actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp">

        <TextView
            android:id="@+id/room_back"
            style="@style/Launcher.LinkButton"
            android:layout_height="36dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:drawableStart="@drawable/ic_arrow_left"
            android:drawablePadding="6dp"
            android:drawableTint="@color/neutral_300"
            android:focusable="true"
            android:text="@string/launcher_nav_rooms"
            android:textColor="@color/neutral_300"
            android:textSize="16sp" />

        <TextView
            style="@style/Launcher.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="10dp"
            android:text="@string/room_details_title" />

        <ImageView
            android:id="@+id/room_lock"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="13dp"
            android:contentDescription="@string/rooms_private"
            android:src="@drawable/ic_lock"
            android:tint="@color/neutral_300"
            android:tooltipText="@string/rooms_private"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_700" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Launcher.FieldLabel"
                android:layout_marginBottom="2dp"
                android:text="@string/room_id" />

            <TextView
                android:id="@+id/room_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neutral_100"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                style="@style/Launcher.FieldLabel"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="2dp"
                android:text="@string/room_type" />

            <TextView
                android:id="@+id/room_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neutral_100"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Launcher.FieldLabel"
                android:layout_marginBottom="2dp"
                android:text="@string/rooms_time_online" />

            <TextView
                android:id="@+id/room_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neutral_100"
                android:textSize="15sp" />

            <TextView
                style="@style/Launcher.FieldLabel"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="@string/room_average_vr" />

            <TextView
                android:id="@+id/room_average_vr"
                style="@style/Launcher.StateBox" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="38dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Launcher.FieldLabel"
                android:layout_marginBottom="0dp"
                android:text="@string/rooms_list_players" />

            <TextView
                android:id="@+id/room_player_count"
                style="@style/Launcher.StateBox"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Above the players' VR column (item_player.xml). -->
        <TextView
            style="@style/Launcher.FieldLabel"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="248dp"
            android:layout_marginBottom="0dp"
            android:text="@string/room_vr"
            android:tooltipText="@string/room_vr_full" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_700" />

    <ListView
        android:id="@+id/room_players"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:listSelector="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />
</LinearLayout>
