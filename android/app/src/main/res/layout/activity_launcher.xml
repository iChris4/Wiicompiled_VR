<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher panel: WheelWizard's layout, a sidebar of pages beside the open page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_900"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wheel"
                android:tint="@color/neutral_400" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/neutral_300"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- WheelWizard's sidebar profile block: the primary licence, opening My profiles. As on the
             PC, its Mii stands on the block's bottom edge and rises out of it: an 80-pixel picture
             beside CurrentUserProfile's 58-pixel column, the text 10 pixels past it. -->
        <FrameLayout
            android:id="@+id/sidebar_profile"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_sidebar_profile"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/sidebar_profile_placeholder"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_circle"
                android:tint="@color/neutral_600" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="73dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sidebar_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/neutral_200"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sidebar_profile_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/neutral_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/sidebar_profile_mii"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="-7dp"
                android:layout_marginBottom="1dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            style="@style/Launcher.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="@string/launcher_section_general" />

        <LinearLayout
            android:id="@+id/nav_home"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:text="@string/launcher_nav_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_profiles"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_circle" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:text="@string/launcher_nav_profiles" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_patches"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_patches" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:text="@string/launcher_nav_patches" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_miis"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shirt" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:text="@string/launcher_nav_miis" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sliders" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:text="@string/launcher_nav_settings" />
        </LinearLayout>

        <TextView
            style="@style/Launcher.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="@string/launcher_section_online" />

        <!-- A TapRow, so a tap on the count opens the page while the pointer still shows its tip. -->
        <org.wiicompiled.quest.launcher.TapRow
            android:id="@+id/nav_rooms"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_room_users" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/launcher_nav_rooms" />

            <!-- WheelWizard's BoxText: the players online now. -->
            <TextView
                android:id="@+id/nav_rooms_count"
                style="@style/Launcher.StateBox"
                android:drawableStart="@drawable/ic_user_couple"
                android:text="0" />
        </org.wiicompiled.quest.launcher.TapRow>

        <LinearLayout
            android:id="@+id/nav_leaderboard"
            style="@style/Launcher.NavItem">

            <ImageView
                style="@style/Launcher.NavIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_award" />

            <TextView
                style="@style/Launcher.NavLabel"
                android:text="@string/launcher_nav_leaderboard" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/launcher_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/neutral_300"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_content"
        android:clipToOutline="true">

        <include
            android:id="@+id/page_home"
            layout="@layout/page_home" />

        <include
            android:id="@+id/page_profiles"
            layout="@layout/page_profiles"
            android:visibility="gone" />

        <include
            android:id="@+id/page_patches"
            layout="@layout/page_patches"
            android:visibility="gone" />

        <include
            android:id="@+id/page_miis"
            layout="@layout/page_miis"
            android:visibility="gone" />

        <include
            android:id="@+id/page_settings"
            layout="@layout/page_settings"
            android:visibility="gone" />

        <include
            android:id="@+id/page_rooms"
            layout="@layout/page_rooms"
            android:visibility="gone" />

        <include
            android:id="@+id/page_leaderboard"
            layout="@layout/page_leaderboard"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
