<?xml version="1.0" encoding="utf-8"?>
<!-- WheelWizard's VrHistoryGraph (VrHistoryPanel): a player's VR over a chosen period, by time or
     by match, on My profiles and in the Rooms page's player profiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Launcher.StatCard"
            android:layout_marginEnd="4dp">

            <TextView
                style="@style/Launcher.StatLabel"
                android:text="@string/history_start" />

            <TextView
                android:id="@+id/history_start"
                style="@style/Launcher.StatValue" />
        </LinearLayout>

        <LinearLayout
            style="@style/Launcher.StatCard"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <TextView
                style="@style/Launcher.StatLabel"
                android:text="@string/history_end" />

            <TextView
                android:id="@+id/history_end"
                style="@style/Launcher.StatValue" />
        </LinearLayout>

        <LinearLayout
            style="@style/Launcher.StatCard"
            android:layout_marginStart="4dp">

            <TextView
                style="@style/Launcher.StatLabel"
                android:text="@string/history_change" />

            <TextView
                android:id="@+id/history_change"
                style="@style/Launcher.StatValue" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Launcher.SectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/history_title" />

        <ProgressBar
            android:id="@+id/history_loading"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/neutral_500"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_matches_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/history_matches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/history_matches"
                android:textColor="@color/neutral_200"
                android:textSize="12sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/history_days"
            android:layout_width="185dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/history_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/neutral_400"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/history_graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_row_single"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/history_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:textColor="@color/neutral_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/history_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:textColor="@color/neutral_400"
                        android:textSize="11sp" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="22dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <org.wiicompiled.quest.launcher.VrHistoryChart
                    android:id="@+id/history_chart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/history_label_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/neutral_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/history_label_mid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/neutral_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/history_label_end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/neutral_400"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/history_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chart"
                android:tint="@color/neutral_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/history_none_title"
                android:textColor="@color/neutral_200"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/history_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:textColor="@color/neutral_400"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
