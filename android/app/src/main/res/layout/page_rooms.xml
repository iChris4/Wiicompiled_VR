<?xml version="1.0" encoding="utf-8"?>
<!-- WheelWizard's Rooms page (Views/Pages/RoomsPage.axaml): the rooms open on Retro WFC, or the
     players whose name or friend code holds the search, with a room's details
     (page_room_details.xml) opened in place of the list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rooms_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/Launcher.PageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_nav_rooms" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="9dp"
                    android:contentDescription="@string/rooms_disclaimer"
                    android:src="@drawable/ic_info"
                    android:tint="@color/neutral_500"
                    android:tooltipText="@string/rooms_disclaimer" />
            </LinearLayout>

            <EditText
                android:id="@+id/rooms_search"
                android:layout_width="240dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search_field"
                android:hint="@string/rooms_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/neutral_100"
                android:textColorHint="@color/neutral_500"
                android:textSize="15sp" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/neutral_700" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/rooms_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_road"
                    android:tint="@color/neutral_600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/rooms_empty_title"
                    android:textColor="@color/neutral_200"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxWidth="440dp"
                    android:text="@string/rooms_empty_message"
                    android:textColor="@color/neutral_400"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rooms_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/rooms_list_title"
                        style="@style/Launcher.FieldLabel"
                        android:layout_marginBottom="0dp" />

                    <TextView
                        android:id="@+id/rooms_list_count"
                        style="@style/Launcher.StateBox"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/neutral_700" />

                <ListView
                    android:id="@+id/rooms_items"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="6dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/rooms_details"
        layout="@layout/page_room_details"
        android:visibility="gone" />
</FrameLayout>
