<?xml version="1.0" encoding="utf-8"?>
<!-- WheelWizard's My profiles page (Views/Pages/UserProfilePage.axaml): the licences of Retro
     Rewind's save and what Retro WFC knows of them. The card and the carousel sit side by side on
     the headset's wide panel rather than one above the other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <TextView
            style="@style/Launcher.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:paddingBottom="10dp"
            android:text="@string/profiles_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="14dp"
            android:text="@string/profiles_save"
            android:textColor="@color/neutral_500"
            android:textSize="12sp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_700" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/profiles_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- The card: the four licences, and the one chosen. -->
            <LinearLayout
                android:id="@+id/profiles_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/profiles_slots"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_profile_slots"
                    android:clipToOutline="true"
                    android:orientation="horizontal"
                    android:padding="1dp" />

                <FrameLayout
                    android:id="@+id/profiles_face"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipToOutline="true">

                    <View
                        android:id="@+id/profiles_glow"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_profile_glow"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/profiles_placeholder"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_user_circle"
                        android:tint="@color/neutral_700" />

                    <ImageView
                        android:id="@+id/profiles_mii"
                        android:layout_width="320dp"
                        android:layout_height="320dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/profiles_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/neutral_50"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:id="@+id/profiles_code_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/profiles_code"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/neutral_200"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/profiles_copy"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/bg_nav_item"
                                android:clickable="true"
                                android:contentDescription="@string/profiles_copy_code"
                                android:focusable="true"
                                android:padding="8dp"
                                android:src="@drawable/ic_copy"
                                android:tint="@color/neutral_500"
                                android:tooltipText="@string/profiles_copy_code" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Make Primary on the left, the badges on the right, scrolling rather than
                         running over it when there are many. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="6dp">

                        <LinearLayout
                            android:id="@+id/profiles_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_nav_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingEnd="10dp"
                            android:tooltipText="@string/profiles_primary_helper">

                            <RadioButton
                                android:id="@+id/profiles_primary_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/primary_400"
                                android:clickable="false"
                                android:focusable="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="@string/profiles_make_primary"
                                android:textColor="@color/neutral_200"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/profiles_badges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal"
                                android:paddingEnd="4dp" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- The carousel: VR history, then the licence's numbers. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1.1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <include
                        android:id="@+id/profiles_history"
                        layout="@layout/view_vr_history"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:id="@+id/profiles_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                style="@style/Launcher.StatCard"
                                android:layout_marginEnd="4dp"
                                android:tooltipText="@string/profiles_vr_full">

                                <TextView
                                    style="@style/Launcher.StatLabel"
                                    android:text="@string/profiles_vr" />

                                <TextView
                                    android:id="@+id/stats_vr"
                                    style="@style/Launcher.StatValue" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/Launcher.StatCard"
                                android:layout_marginStart="4dp"
                                android:tooltipText="@string/profiles_br_full">

                                <TextView
                                    style="@style/Launcher.StatLabel"
                                    android:text="@string/profiles_br" />

                                <TextView
                                    android:id="@+id/stats_br"
                                    style="@style/Launcher.StatValue" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                style="@style/Launcher.StatCard"
                                android:layout_marginEnd="4dp">

                                <TextView
                                    style="@style/Launcher.StatLabel"
                                    android:text="@string/profiles_total_won" />

                                <TextView
                                    android:id="@+id/stats_wins"
                                    style="@style/Launcher.StatValue" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/Launcher.StatCard"
                                android:layout_marginStart="4dp">

                                <TextView
                                    style="@style/Launcher.StatLabel"
                                    android:text="@string/profiles_total_played" />

                                <TextView
                                    android:id="@+id/stats_races"
                                    style="@style/Launcher.StatValue" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/profiles_previous"
                        style="@style/Launcher.CarouselArrow"
                        android:contentDescription="@string/profiles_previous"
                        android:src="@drawable/ic_arrow_left" />

                    <View
                        android:id="@+id/profiles_dot0"
                        android:layout_width="26dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="8dp" />

                    <View
                        android:id="@+id/profiles_dot1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/profiles_next"
                        style="@style/Launcher.CarouselArrow"
                        android:contentDescription="@string/profiles_next"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profiles_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_circle"
                android:tint="@color/neutral_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/profiles_empty_title"
                android:textColor="@color/neutral_200"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="440dp"
                android:text="@string/profiles_empty_message"
                android:textColor="@color/neutral_400"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
