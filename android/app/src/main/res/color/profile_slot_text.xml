<?xml version="1.0" encoding="utf-8"?>
<!-- ProfileSelector's text: white when chosen, primary under the pointer, plain when empty. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/neutral_200" android:state_enabled="false" />
    <item android:color="@color/neutral_50" android:state_selected="true" />
    <item android:color="@color/primary_300" android:state_hovered="true" />
    <item android:color="@color/neutral_200" />
</selector>
